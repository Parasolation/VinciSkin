# Dependencies
node_modules/

# Only pnpm is supported (see packageManager in package.json)
package-lock.json
yarn.lock

# Build output
dist/
coverage/

# Generated Tauri ACL schemas, rewritten by tauri-build on every build
gen/

# Editor
.vscode/
.idea/
*.sw?
*.iml

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Environment
.env
.env.*
!.env.example

# Local signing override, passed to tauri --config
tauri.local-signoff.conf.json

# Rust build artifacts
debug/
target/
**/*.rs.bk
*.pdb

# Backup and patch leftovers
*.bak
*.bak-*
*.orig
*.rej

# TypeScript incremental state
*.tsbuildinfo

# ts-rs default output (real bindings go to src/lib/bindings/)
src-tauri/bindings/
src-tauri/src/lib/bindings/

# Paraglide output, compiled from messages/ (see ADR-0018)
src/paraglide/

# TanStack tool cache
.tanstack/

# AI local settings
.agents/
.claude/
.codex/
.mcp.json
.scratch/

# Windows
nul
