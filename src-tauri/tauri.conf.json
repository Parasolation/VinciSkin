{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinciSkin",
  "identifier": "com.vinciskin.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VinciSkin",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0c0d18"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: http://asset.localhost vinciskin-asset: http://vinciskin-asset.localhost https://game.gtimg.cn; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost vinciskin-asset: http://vinciskin-asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/**/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net/ -a runeforge -c Natoken -d VinciSkin %1",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vinciskin"]
      }
    }
  }
}